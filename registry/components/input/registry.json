{
  "name": "input",
  "type": "component",
  "title": "VInput",
  "description": "Mobile text input with clear, prefix, suffix, validation, and controlled value states.",
  "exportName": "VInput",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "@varo-ui/theme",
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "components/icon",
      "utils/cn"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/input/input.ts",
      "to": "src/components/ui/input.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/input/v-input.vue",
      "to": "src/components/ui/v-input.vue"
    }
  ],
  "docs": "/components/input"
}
