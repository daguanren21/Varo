  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "utils/cn"
    ]
  },
  "files": [
