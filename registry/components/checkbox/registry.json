{
  "name": "checkbox",
  "platforms": ["alipay", "tt", "xhs", "donut-android", "donut-ios", "donut-ohos"],
  "type": "component",
  "title": "VCheckbox",
  "description": "Single and grouped checkbox controls with indeterminate, invalid, readonly, disabled, and selection-limit states.",
  "exportName": "VCheckbox",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "components/icon"
  ],
  "targetRegistryDependencies": {
    "h5": [
      "utils/selection"
    ],
    "weapp": [
      "utils/primitives"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/checkbox/checkbox.ts",
      "to": "src/components/ui/checkbox.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/checkbox/weapp-vite.vue",
      "to": "src/components/ui/v-checkbox.vue"
    },
    {
      "target": "weapp",
      "from": "registry/components/checkbox/checkbox-group.weapp-vite.vue",
      "to": "src/components/ui/v-checkbox-group.vue"
    },
    {
      "target": "weapp",
      "from": "registry/components/checkbox/selection-context.ts",
      "to": "src/components/ui/selection-context.ts"
    },
    {
      "target": "h5",
      "from": "registry/themes/components/checkbox/h5.css",
      "to": "src/styles/varo-checkbox.css"
    },
    {
      "target": "weapp",
      "from": "registry/themes/components/checkbox/weapp-vite.css",
      "to": "src/styles/varo-checkbox.css"
    }
  ],
  "docs": "/components/checkbox"
}
