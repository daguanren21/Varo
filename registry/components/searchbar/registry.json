{
  "name": "searchbar",
  "type": "component",
  "title": "VSearchbar",
  "description": "Search input composition with clear, submit, and cancel behavior.",
  "exportName": "VSearchbar",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "@varo-ui/theme",
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "components/input"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "components/icon",
      "utils/cn"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/searchbar/searchbar.ts",
      "to": "src/components/ui/searchbar.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/searchbar/v-searchbar.vue",
      "to": "src/components/ui/v-searchbar.vue"
    }
  ],
  "docs": "/components/searchbar"
}
