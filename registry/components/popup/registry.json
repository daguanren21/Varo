{
  "name": "popup",
  "type": "component",
  "title": "VPopup",
  "description": "Positioned overlay panel for sheets, drawers, and transient content.",
  "exportName": "VPopup",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "components/icon",
      "components/overlay",
      "utils/cn"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/popup/popup.ts",
      "to": "src/components/ui/popup.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/popup/v-popup.vue",
      "to": "src/components/ui/v-popup.vue"
    }
  ],
  "docs": "/components/popup"
}
