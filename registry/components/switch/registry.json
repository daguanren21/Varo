{
  "name": "switch",
  "platforms": ["alipay", "tt", "xhs", "donut-android", "donut-ios", "donut-ohos"],
  "type": "component",
  "title": "VSwitch",
  "description": "Binary control with controlled value, loading, readonly, disabled, and size states.",
  "exportName": "VSwitch",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "files": [
    {
      "target": "h5",
      "from": "registry/components/switch/switch.ts",
      "to": "src/components/ui/switch.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/switch/weapp-vite.vue",
      "to": "src/components/ui/v-switch.vue"
    },
    {
      "target": "h5",
      "from": "registry/themes/components/switch/h5.css",
      "to": "src/styles/varo-switch.css"
    },
    {
      "target": "weapp",
      "from": "registry/themes/components/switch/weapp-vite.css",
      "to": "src/styles/varo-switch.css"
    }
  ],
  "docs": "/components/switch"
}
