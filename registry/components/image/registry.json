{
  "name": "image",
  "type": "component",
  "title": "VImage",
  "description": "Image wrapper with loading, fallback, fit, and aspect-ratio states.",
  "exportName": "VImage",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "files": [
    {
      "target": "h5",
      "from": "registry/components/image/image.ts",
      "to": "src/components/ui/image.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/image/weapp-vite.vue",
      "to": "src/components/ui/v-image.vue"
    },
    {
      "target": "h5",
      "from": "registry/themes/components/image/h5.css",
      "to": "src/styles/varo-image.css"
    },
    {
      "target": "weapp",
      "from": "registry/themes/components/image/weapp-vite.css",
      "to": "src/styles/varo-image.css"
    }
  ],
  "docs": "/components/image"
}
