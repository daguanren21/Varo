{
  "name": "form",
  "platforms": ["alipay", "tt", "xhs", "donut-android", "donut-ios", "donut-ohos"],
  "type": "component",
  "title": "VForm",
  "description": "Typed form and field controls with validation, status, and submit contracts.",
  "exportName": "VForm",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless",
    "@varo-ui/theme"
  ],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "utils/primitives"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/form/form.ts",
      "to": "src/components/ui/form.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/form/form.weapp.ts",
      "to": "src/components/ui/form.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/form/form-context.weapp.ts",
      "to": "src/components/ui/form-context.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/form/v-form.weapp-vite.vue",
      "to": "src/components/ui/v-form.vue"
    },
    {
      "target": "weapp",
      "from": "registry/components/form/v-form-item.weapp-vite.vue",
      "to": "src/components/ui/v-form-item.vue"
    },
    {
      "target": "h5",
      "from": "registry/themes/components/form/h5.css",
      "to": "src/styles/varo-form.css"
    },
    {
      "target": "weapp",
      "from": "registry/themes/components/form/weapp-vite.css",
      "to": "src/styles/varo-form.css"
    }
  ],
  "docs": "/components/form"
}
