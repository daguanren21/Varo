{
  "name": "overlay",
  "type": "component",
  "title": "VOverlay",
  "description": "Dismissible backdrop layer for dialogs, popups, and sheets.",
  "exportName": "VOverlay",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "utils/cn"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/overlay/overlay.ts",
      "to": "src/components/ui/overlay.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/overlay/v-overlay.vue",
      "to": "src/components/ui/v-overlay.vue"
    }
  ],
  "docs": "/components/overlay"
}
