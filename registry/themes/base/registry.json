{
  "name": "base",
  "platforms": ["alipay", "tt", "xhs", "donut-android", "donut-ios", "donut-ohos"],
  "type": "theme",
  "title": "Varo Base Theme",
  "description": "Shared UI design tokens and animation foundation. Component styles are owned by their component manifests; Agent styles are optional.",
  "targets": ["h5", "weapp"],
  "dependencies": [],
  "registryDependencies": [],
  "files": [
    {
      "target": "h5",
      "from": "registry/themes/base/h5.css",
      "to": "src/styles/varo.css"
    },
    {
      "target": "weapp",
      "from": "registry/themes/base/weapp-vite.css",
      "to": "src/styles/varo.css"
    }
  ],
  "docs": "/guide/theme"
}
