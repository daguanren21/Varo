{
  "name": "agent-activity",
  "type": "block",
  "title": "Agent Activity Tasks",
  "description": "Controlled six-state activity and task actions with guarded start, approval, retry and cancellation intents. Execution and transitions remain application-owned.",
  "targets": ["h5", "weapp"],
  "targetDependencies": {
    "h5": ["vue"],
    "weapp": ["wevu"]
  },
  "registryDependencies": ["components/agent-advanced", "components/button"],
  "files": [
    {
      "target": "h5",
      "from": "registry/blocks/agent-activity/h5.vue",
      "to": "src/components/blocks/agent-activity.vue"
    },
    {
      "target": "weapp",
      "from": "registry/blocks/agent-activity/weapp-vite.vue",
      "to": "src/components/blocks/agent-activity.vue"
    },
    {
      "target": "h5",
      "from": "registry/blocks/agent-activity/agent-activity-actions.ts",
      "to": "src/components/blocks/agent-activity-actions.ts"
    },
    {
      "target": "weapp",
      "from": "registry/blocks/agent-activity/agent-activity-actions.ts",
      "to": "src/components/blocks/agent-activity-actions.ts"
    }
  ],
  "docs": "/ai/agent-activity-block"
}
