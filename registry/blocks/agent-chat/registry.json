{
  "name": "agent-chat",
  "type": "block",
  "title": "Agent Chat",
  "description": "Panel or full-page Agent conversation with an empty welcome, injected history, busy-only stop intent, event rendering, and prompt composition.",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/ai"
  ],
  "targetDependencies": {
    "h5": ["vue"],
    "weapp": ["wevu"]
  },
  "registryDependencies": [
    "components/agent-conversation",
    "components/button",
    "utils/primitives"
  ],
  "files": [
    {
      "target": "h5",
      "from": "registry/blocks/agent-chat/h5.vue",
      "to": "src/components/blocks/agent-chat.vue"
    },
    {
      "target": "weapp",
      "from": "registry/blocks/agent-chat/weapp-vite.vue",
      "to": "src/components/blocks/agent-chat.vue"
    },
    {
      "target": "h5",
      "from": "registry/blocks/agent-chat/agent-chat.types.ts",
      "to": "src/components/blocks/agent-chat.types.ts"
    },
    {
      "target": "weapp",
      "from": "registry/blocks/agent-chat/agent-chat.types.ts",
      "to": "src/components/blocks/agent-chat.types.ts"
    }
  ],
  "docs": "/ai/agent-chat"
}
