{
  "name": "@varo/playground-weapp-preview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:artifacts": "pnpm exec turbo run build --filter=@varo/playground-weapp",
    "dev": "pnpm run prepare:artifacts && vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:browser": "node scripts/smoke-preview.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@varo-ui/h5": "workspace:*",
    "@varo/weapp-web": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@varo/playground-weapp": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
