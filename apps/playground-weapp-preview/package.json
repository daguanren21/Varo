{
  "name": "@varo/playground-weapp-preview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./docs-scenarios": "./src/docs-scenarios.ts",
    "./preview-loading": "./src/components/PreviewLoading.vue"
  },
  "scripts": {
    "prepare:artifacts": "node scripts/prepare-artifacts.mjs",
    "dev": "node scripts/prepare-artifacts.mjs && vite",
