{
  "name": "@varo/playground-weapp-preview",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:artifacts": "pnpm exec turbo run build:preview --filter=@varo/playground-weapp",
    "dev": "pnpm run prepare:artifacts && vite",
    "build": "pnpm run prepare:artifacts && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests"
  },
  "dependencies": {
    "@varo-ui/h5": "workspace:*",
    "@varo/weapp-web": "workspace:*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@varo/playground-weapp": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
