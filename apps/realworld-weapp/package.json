{
  "name": "@varo/realworld-weapp",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "analyze": "cross-env VARO_WEAPP_OUTPUT=production wv analyze -p weapp",
    "prebuild": "pnpm run verify:migration",
    "build": "cross-env VARO_WEAPP_OUTPUT=production wv build -p weapp && node scripts/prepare-devtools-project.mjs && node scripts/verify-devtools-project.mjs",
    "dev": "node scripts/prepare-devtools-project.mjs && cross-env VARO_WEAPP_OUTPUT=development wv dev -p weapp --project-config dist/dev/project.config.json",
    "postinstall": "wv prepare -p weapp",
    "prepare:weapp": "wv prepare -p weapp",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "verify:migration": "node scripts/verify-migration.mjs"
  },
  "dependencies": {
    "@varo-ui/theme": "workspace:^",
    "@weapp-tailwindcss/merge": "^2.2.7",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.1",
    "mitt": "^3.0.1",
    "wevu": "7.8.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "miniprogram-api-typings": "^5.2.3",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "weapp-tailwindcss": "^5.6.3",
    "weapp-vite": "7.8.0"
  }
}
