{
  "name": "varo-retail-taro-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "license": "MIT",
  "engines": { "node": "^22.23.4 || ^24.22.1 || >=26.12.1" },
  "scripts": {
    "dev": "pnpm dev:h5",
    "dev:h5": "node scripts/prepare-taro-project.mjs && taro build --type h5 --watch",
    "dev:weapp": "node scripts/prepare-taro-project.mjs && taro build --type weapp --watch",
    "build": "pnpm build:h5 && pnpm build:weapp",
    "build:h5": "node scripts/prepare-taro-project.mjs && taro build --type h5",
    "build:weapp": "node scripts/prepare-taro-project.mjs && taro build --type weapp && pnpm verify",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-native.mjs"
  },
  "browserslist": ["defaults and fully supports es6-module", "maintained node versions"],
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@tarojs/components": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "@weapp-tailwindcss/merge": "2.2.7",
    "clsx": "2.1.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@csstools/css-tokenizer": "4.0.2",
    "@tarojs/cli": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-vue3": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/runner-utils": "4.3.2",
    "@tarojs/taro-loader": "4.3.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/node": "26.6.6",
    "@vue/babel-plugin-jsx": "1.5.0",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/runtime-core": "3.5.45",
    "babel-preset-taro": "4.3.2",
    "htmlparser2": "12.0.0",
    "less": "4.9.1",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "solid-js": "1.9.18",
    "stylus": "0.64.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vue-loader": "17.4.2",
    "vue-tsc": "3.3.14",
    "weapp-tailwindcss": "5.6.3",
    "webpack": "5.111.1"
  }
}
