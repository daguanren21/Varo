  "packageManager": "pnpm@11.24.0",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "pnpm dev:h5",
    "dev:h5": "node scripts/prepare-uni-project.mjs && uni -p h5 --host 127.0.0.1",
    "dev:mp-weixin": "node scripts/prepare-uni-project.mjs && uni -p mp-weixin",
    "build": "pnpm build:h5 && pnpm build:mp-weixin",
    "build:h5": "node scripts/prepare-uni-project.mjs && uni build -p h5",
    "build:mp-weixin": "node scripts/prepare-uni-project.mjs && uni build -p mp-weixin && pnpm verify",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-native.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@weapp-tailwindcss/merge": "2.2.7",
    "clsx": "2.1.1",
    "vue": "3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@csstools/css-tokenizer": "4.0.2",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/node": "26.6.6",
    "@vue/runtime-core": "3.4.21",
    "htmlparser2": "12.0.0",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vue-tsc": "3.3.14",
    "weapp-tailwindcss": "5.6.3"
  }
