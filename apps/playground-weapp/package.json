{
  "name": "@varo/playground-weapp",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "weapp-vite build && node scripts/localize-native-components.mjs && node scripts/prepare-devtools-project.mjs && node scripts/verify-devtools-project.mjs",
    "build:preview": "WEAPP_ROBOT_CHAT=1 weapp-vite build --mode browser-preview --project-config project.browser.json",
    "clean": "rimraf dist devtools .weapp-vite",
    "dev": "node scripts/prepare-devtools-project.mjs && weapp-vite --project-config .weapp-vite/project.dev.config.json",
    "capture:blocks": "node e2e/capture-blocks.mjs",
    "dev:ai": "node scripts/prepare-devtools-project.mjs && weapp-vite --project-config .weapp-vite/project.dev.config.json --open",
    "open": "node scripts/prepare-devtools-project.mjs && weapp-vite open devtools/build",
    "prepare:weapp": "weapp-vite prepare",
    "lint": "echo weapp playground lint pending",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vite.config.ts --environment jsdom --dir src --passWithNoTests && vitest run --config vite.config.ts --environment jsdom --dir scripts --passWithNoTests=false",
    "smoke:a2ui": "node e2e/a2ui-runtime-smoke.mjs",
    "smoke:blocks": "node e2e/block-runtime-smoke.mjs",
    "smoke:runtime": "node e2e/runtime-smoke.mjs",
    "smoke:theme": "node e2e/theme-runtime-smoke.mjs",
    "smoke:retail": "node e2e/retail-runtime-smoke.mjs",
    "test:contracts": "vitest run --config ../../vitest.config.ts --dir contracts --environment node --passWithNoTests=false"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@tanstack/ai": "1.4.0",
    "@tanstack/ai-client": "1.1.0",
    "@varo-ui/ai": "workspace:^",
    "@varo-ui/headless": "workspace:*",
    "@varo-ui/theme": "workspace:*",
    "@varo-ui/weapp": "workspace:*",
    "@weapp-tailwindcss/merge": "^2.2.4",
    "clsx": "^2.1.1",
    "wevu": "7.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@csstools/css-tokenizer": "4.0.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@weapp-vite/miniprogram-automator": "1.5.5",
    "pngjs": "7.0.0",
    "postcss-selector-parser": "7.1.6",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.0",
    "vue": "^3.5.45",
    "weapp-tailwindcss": "^5.5.6",
    "weapp-vite": "7.11.1"
  }
}
