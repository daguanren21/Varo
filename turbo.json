{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@varo-ui/ai#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "runtime/**"]
    },
    "@varo/playground-weapp#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["WEAPP_ROBOT_CHAT"],
      "passThroughEnv": ["WEAPP_APP_ID"],
      "outputs": ["devtools/build/mp-weixin/**"]
    },
    "@varo/playground-weapp#build:preview": {
      "dependsOn": ["^build"],
      "outputs": ["dist/browser/mp-weixin/**"]
    },
    "@varo/weapp-web#build": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@varo/devtools#typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "@varo/devtools#test": {
      "dependsOn": ["^build", "^test"],
      "outputs": ["coverage/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "test:contracts": {
      "cache": false
    }
  }
}
