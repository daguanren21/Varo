{
  "name": "@varo/primitives-h5",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Internal H5 headless primitives bundled into @varo-ui/headless.",
  "author": "daguanren21 <1363917353@qq.com>",
  "license": "MIT",
  "homepage": "https://daguanren21.github.io/Varo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/Varo.git",
    "directory": "packages/primitives-h5"
  },
  "bugs": {
    "url": "https://github.com/daguanren21/Varo/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.mts",
      "import": "./dist/hooks.mjs"
    },
    "./parts": {
      "types": "./dist/parts.d.mts",
      "import": "./dist/parts.mjs"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./source/parts": {
      "types": "./src/parts.ts",
      "import": "./src/parts.ts"
    },
    "./source/hooks": {
      "types": "./src/hooks.ts",
      "import": "./src/hooks.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "echo primitives-h5 lint pending",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "echo primitives-h5 has no e2e"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@varo-ui/headless": "workspace:*",
    "@varo/shared": "workspace:*"
  }
}
