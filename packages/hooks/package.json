{
  "name": "@varo/hooks",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Vue composables and form hooks for Varo component systems.",
  "author": "daguanren21 <1363917353@qq.com>",
  "license": "MIT",
  "homepage": "https://daguanren21.github.io/Varo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/Varo.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/daguanren21/Varo/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "echo hooks lint pending",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "echo hooks has no e2e"
  },
  "dependencies": {
    "@varo/utils": "workspace:*"
  }
}
