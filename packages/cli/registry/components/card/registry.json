{
  "name": "card",
  "type": "component",
  "title": "VCard",
  "description": "Composable card anatomy for headers, titles, descriptions, content, and actions.",
  "exportName": "VCard",
  "targets": [
    "h5",
    "weapp-vite"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": ["vue"],
    "weapp-vite": ["wevu"]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "files": [
    {
      "target": "h5",
      "from": "registry/components/card/card.ts",
      "to": "src/components/ui/card.ts"
    },
    {
      "target": "weapp-vite",
      "from": "registry/components/card/weapp-vite.vue",
      "to": "src/components/ui/v-card.vue"
    }
  ],
  "docs": "/guide/shadcn-mode"
}
