{
  "name": "rate",
  "type": "component",
  "title": "VRate",
  "description": "Rating input with controlled value, count, and readonly states.",
  "exportName": "VRate",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "@varo-ui/theme",
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base"
  ],
  "targetRegistryDependencies": {
    "weapp": [
      "utils/cn"
    ]
  },
  "files": [
    {
      "target": "h5",
      "from": "registry/components/rate/rate.ts",
      "to": "src/components/ui/rate.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/rate/v-rate.vue",
      "to": "src/components/ui/v-rate.vue"
    }
  ],
  "docs": "/components/rate"
}
