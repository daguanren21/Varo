{
  "name": "select",
  "type": "component",
  "title": "VSelect",
  "description": "Searchable single or multiple select with groups, placeholder, and disabled options.",
  "exportName": "VSelect",
  "targets": [
    "h5",
    "weapp"
  ],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "vue"
    ],
    "weapp": [
      "wevu"
    ]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "files": [
    {
      "target": "h5",
      "from": "registry/components/select/select.ts",
      "to": "src/components/ui/select.ts"
    },
    {
      "target": "weapp",
      "from": "registry/components/select/weapp-vite.vue",
      "to": "src/components/ui/select.vue"
    }
  ],
  "docs": "/components/select"
}
