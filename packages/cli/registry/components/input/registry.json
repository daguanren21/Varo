{
  "name": "input",
  "type": "component",
  "title": "VInput",
  "description": "Mobile text input with clear, prefix, suffix, validation, and controlled value states.",
  "exportName": "VInput",
  "targets": [
    "h5",
    "weapp-vite"
  ],
  "dependencies": [
    "@varo/shared",
    "@varo/theme"
  ],
  "targetDependencies": {
    "h5": ["vue"],
    "weapp-vite": ["wevu", "vue"]
  },
  "registryDependencies": [
    "themes/base",
    "utils/primitives"
  ],
  "files": [
    {
      "target": "h5",
      "from": "registry/components/input/input.ts",
      "to": "src/components/ui/input.ts"
    },
    {
      "target": "weapp-vite",
      "from": "registry/components/input/weapp-vite.vue",
      "to": "src/components/ui/v-input.vue"
    },
    {
      "target": "weapp-vite",
      "from": "registry/components/input/input.ts",
      "to": "src/components/ui/input.ts"
    }
  ],
  "docs": "/components/input"
}
