{
  "name": "primitives",
  "type": "util",
  "title": "Platform Primitives Adapter",
  "description": "Target-specific adapter that gives copied components one stable primitives import path.",
  "targets": ["h5", "weapp-vite"],
  "dependencies": [
    "@varo-ui/headless"
  ],
  "targetDependencies": {
    "h5": [
      "@varo-ui/h5",
      "vue"
    ],
    "weapp-vite": [
      "@varo-ui/weapp",
      "wevu"
    ]
  },
  "registryDependencies": [],
  "files": [
    {
      "target": "h5",
      "from": "registry/utils/primitives/h5.ts",
      "to": "src/lib/varo-primitives.ts"
    },
    {
      "target": "weapp-vite",
      "from": "registry/utils/primitives/weapp-vite.ts",
      "to": "src/lib/varo-primitives.ts"
    }
  ],
  "docs": "/guide/shadcn-mode"
}
