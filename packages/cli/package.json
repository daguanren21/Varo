{
  "name": "@varo-ui/cli",
  "type": "module",
  "version": "1.2.0",
  "description": "CLI for installing editable Varo components and blocks from the Registry.",
  "author": "daguanren21 <1363917353@qq.com>",
  "license": "MIT",
  "homepage": "https://daguanren21.github.io/Varo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/Varo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/daguanren21/Varo/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./source": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "varo": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "echo cli lint pending",
    "postpack": "rimraf registry",
    "prepack": "node scripts/sync-registry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "echo cli has no e2e"
  },
  "devDependencies": {
    "@varo/registry": "workspace:*"
  }
}
