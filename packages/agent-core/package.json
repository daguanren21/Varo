{
  "name": "@varo-ui/ai",
  "type": "module",
  "version": "2.2.0",
  "description": "Shared event protocol, streaming controller, and safe Markdown primitives for Varo Agent UI.",
  "author": "daguanren21 <1363917353@qq.com>",
  "license": "MIT",
  "homepage": "https://daguanren21.github.io/Varo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/Varo.git",
    "directory": "packages/agent-core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/daguanren21/Varo/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "THIRD_PARTY_NOTICES.txt",
    "dist",
    "runtime",
    "src"
  ],
  "scripts": {
    "build": "pnpm build:runtime && tsdown",
    "build:runtime": "tsdown --config tsdown.runtime.config.ts",
    "clean": "rimraf dist runtime",
    "dev": "pnpm build:runtime && tsdown --watch",
    "prepack": "pnpm build",
    "lint": "echo agent-core lint pending",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests"
  },
  "dependencies": {
    "markstream-core": "^2.0.12",
    "stream-markdown-parser": "1.2.18"
  },
  "devDependencies": {
    "base64-js": "1.5.1"
  }
}
