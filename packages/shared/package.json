{
    "name":  "@varo/shared",
    "version":  "0.1.0",
    "type":  "module",
    "sideEffects":  false,
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/daguanren21/Varo.git"
                   },
    "publishConfig":  {
                          "access":  "public",
                          "registry":  "https://registry.npmjs.org/"
                      },
    "main":  "./dist/index.mjs",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.mts",
    "files":  [
                  "dist",
                  "src"
              ],
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.mts",
                              "import":  "./dist/index.mjs"
                          },
                    "./source":  {
                                     "types":  "./src/index.ts",
                                     "import":  "./src/index.ts"
                                 }
                },
    "scripts":  {
                    "build":  "tsdown",
                    "clean":  "rimraf dist",
                    "dev":  "tsdown --watch",
                    "lint":  "echo shared lint pending",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "vitest run --passWithNoTests",
                    "test:e2e":  "echo shared has no e2e"
                }
}
