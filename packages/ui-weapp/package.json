{
  "name": "@varo-ui/weapp",
  "type": "module",
  "version": "2.1.0",
  "description": "Canonical native Wevu SFC sources and Registry component resolver.",
  "author": "daguanren21 <1363917353@qq.com>",
  "license": "MIT",
  "homepage": "https://daguanren21.github.io/Varo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daguanren21/Varo.git",
    "directory": "packages/ui-weapp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/daguanren21/Varo/issues"
  },
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./native/src/index.ts",
    "./components/*": "./native/src/components/ui/*",
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "import": "./dist/resolver.mjs"
    },
    "./style.css": "./src/style.css",
    "./source/style.css": "./src/style.css"
  },
  "main": "./native/src/index.ts",
  "module": "./native/src/index.ts",
  "types": "./native/src/index.ts",
  "files": [
    "dist",
    "native",
    "src/style.css"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "echo ui-weapp lint pending",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir . --passWithNoTests",
    "test:e2e": "echo ui-weapp has no e2e"
  },
  "peerDependencies": {
    "weapp-vite": ">=7.2.1 <8",
    "wevu": ">=7.2.1 <8"
  },
  "dependencies": {
    "@varo-ui/headless": "workspace:*",
    "@varo-ui/theme": "workspace:*",
    "@weapp-tailwindcss/merge": "^2.2.4",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "weapp-vite": "7.4.0",
    "wevu": "7.4.0"
  }
}
