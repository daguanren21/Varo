{
  "name": "varo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "sync:registry": "node scripts/sync-styles.mjs && node scripts/sync-component-styles.mjs && node scripts/sync-registry.mjs",
    "check:generated": "node scripts/sync-styles.mjs --check && node scripts/sync-component-styles.mjs --check && node scripts/sync-registry.mjs --check",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "check:consumers": "node scripts/verify-consumers.mjs",
    "check:platforms": "node scripts/verify-platforms.mjs",
    "check:full": "pnpm check:generated && pnpm check:architecture && pnpm exec repo check --full && pnpm test:contracts && pnpm test:e2e:runner && pnpm test:e2e && pnpm check:consumers && pnpm check:platforms",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run build --filter=@varo/playground-weapp-preview && turbo run dev --parallel --concurrency=20",
    "docs:dev": "pnpm --dir apps/docs dev",
    "dev:playground-h5": "pnpm --filter @varo/playground-h5 dev",
    "dev:playground-weapp": "pnpm --filter @varo/playground-weapp dev",
    "lint": "turbo run lint",
    "retail:export": "node apps/playground-weapp/scripts/export-retail-starter.mjs",
    "release": "pnpm change",
    "release:prepare": "repo release stable prepare",
    "release:publish": "repo release stable publish",
    "publish-packages": "repo release stable publish",
    "version-packages": "pnpm version -r",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "prepare": "pnpm --filter @varo-ui/ai build:runtime && repo tooling hooks install",
    "commitlint": "commitlint --edit",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.config.ts --dir scripts && turbo run test",
    "test:contracts": "turbo run test:contracts",
    "test:e2e": "pnpm test:e2e:web && pnpm test:e2e:weapp",
    "test:e2e:web": "pnpm --filter @varo/e2e test:e2e --suite web",
    "test:e2e:weapp": "pnpm --filter @varo/e2e test:e2e --suite weapp",
    "test:e2e:devtools": "pnpm --filter @varo/e2e test:e2e --suite devtools",
    "test:e2e:runner": "pnpm --filter @varo/e2e test:runner"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@microsoft/api-extractor": "^7.60.1",
    "@pnpm/logger": "^1100.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "~5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "lefthook": "2.2.2",
    "miniprogram-api-typings": "^5.2.3",
    "repoctl": "^6.4.0",
    "rimraf": "^6.1.4",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "2.0.0",
    "tsdown": "0.23.5",
    "tslib": "2.9.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14",
    "weapp-tailwindcss": "^5.6.3",
    "weapp-vite": "7.8.0",
    "wevu": "7.8.0"
  }
}
