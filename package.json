{
  "name": "varo",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "sync:registry": "node scripts/sync-styles.mjs && node scripts/sync-component-styles.mjs && node scripts/sync-registry.mjs",
    "check:generated": "node scripts/sync-styles.mjs --check && node scripts/sync-component-styles.mjs --check && node scripts/sync-registry.mjs --check",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "check:consumers": "node scripts/verify-consumers.mjs",
    "check:platforms": "node scripts/verify-platforms.mjs",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "docs:dev": "pnpm --dir apps/docs dev",
    "dev:playground-h5": "pnpm --filter @varo/playground-h5 dev",
    "dev:playground-weapp": "pnpm --filter @varo/playground-weapp dev",
    "lint": "turbo run lint",
    "release": "pnpm change",
    "release:prepare": "repo release stable prepare",
    "release:publish": "repo release stable publish",
    "publish-packages": "repo release stable publish",
    "version-packages": "pnpm version -r",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.config.ts --dir scripts && turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@microsoft/api-extractor": "^7.59.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "~5.0.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "miniprogram-api-typings": "^5.2.3",
    "repoctl": "^5.5.4",
    "rimraf": "^6.1.3",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "2.0.0",
    "tsdown": "0.23.0",
    "tslib": "2.8.1",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11",
    "weapp-tailwindcss": "^5.5.6",
    "weapp-vite": "7.4.0",
    "wevu": "7.4.0"
  }
}
