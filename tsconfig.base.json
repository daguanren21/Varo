{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@varo/shared": ["packages/shared/src/index.ts"],
      "@varo/theme": ["packages/theme/src/index.ts"],
      "@varo/primitives-core": ["packages/primitives-core/src/index.ts"],
      "@varo/primitives-h5": ["packages/primitives-h5/src/index.ts"],
      "@varo/primitives-weapp": ["packages/primitives-weapp/src/index.ts"],
      "@varo/ui-h5": ["packages/ui-h5/src/index.ts"],
      "@varo/ui-weapp": ["packages/ui-weapp/src/index.ts"]
    }
  }
}
